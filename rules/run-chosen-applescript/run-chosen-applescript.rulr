                },
                "script": {
                  "type": "dictionary",
                  "value": {
                    "filePath": {
                      "type": "string",
                      "value": ""
                    },
                    "mode": {
                      "type": "string",
                      "value": "text-script"
                    },
                    "text": {
                      "type": "string",
                      "value": "on run argv\n    if (count argv) is 0 then error \"Configure the trusted AppleScript file path in this Action's Arguments before enabling the schedule.\"\n    set scriptPath to item 1 of argv\n    if scriptPath starts with \"~/\" then\n        set scriptPath to POSIX path of (path to home folder) & text 3 thru -1 of scriptPath\n    end if\n    set scriptFile to POSIX file scriptPath as alias\n    set loadedScript to load script scriptFile\n    run script loadedScript\nend run\n"
                    }
                  }
                },
                "stopsFlowWhenUnsuccessful": {
                  "type": "boolean",
                  "value": true
                },
                "timeout": {
                  "type": "number",
                  "value": 120
                }
              }
            },
            "id": "8DFAF602-80F8-5BF5-8A1C-F3E3C6A5C1DB",
            "key": "action.run-apple-script"
          }
        ],
        "kind": "action",
        "title": "Schedule AppleScript File"
