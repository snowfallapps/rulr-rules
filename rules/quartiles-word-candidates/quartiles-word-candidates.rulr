                        }
                      }
                    }
                  ]
                },
                "script": {
                  "type": "dictionary",
                  "value": {
                    "filePath": {
                      "type": "string",
                      "value": ""
                    },
                    "mode": {
                      "type": "string",
                      "value": "text-script"
                    },
                    "text": {
                      "type": "string",
                      "value": "exec /usr/bin/osascript -l JavaScript - \"$1\" <<'RULR_QUARTILES_JS'\n// Candidate finder only. The local dictionary is not Apple's accepted-answer list.\nObjC.import('Foundation');\n\nfunction run(argv) {\n    if (argv.length !== 1) throw new Error('Expected one list of 20 puzzle tiles.');\n    var tiles = String(argv[0]).toLowerCase().trim().split(/[\\s,]+/);\n    if (tiles.length !== 20 || tiles.some(function (t) { return !/^[a-z]{1,12}$/.test(t); })) {\n        throw new Error('Enter exactly 20 English letter tiles, separated by spaces or commas.');\n    }\n    // A machine-specific dictionary path may be selected here if this file is absent.\n    var dictionaryPath = '/usr/share/dict/words';\n    var readError = Ref();\n    var dictionaryString = $.NSString.stringWithContentsOfFileEncodingError(dictionaryPath, $.NSUTF8StringEncoding, readError);\n    var text = ObjC.unwrap(dictionaryString);\n    if (typeof text !== 'string' || !text.length) throw new Error('A readable UTF-8 dictionary with one word per line is required: ' + dictionaryPath);\n    if (text.length > 12000000) throw new Error('Choose a dictionary smaller than 12 million characters.');\n    var dictionary = Object.create(null);\n    text.split(/\\r?\\n/).forEach(function (line) {\n        var word = line.trim().toLowerCase();\n        if (/^[a-z]+$/.test(word)) dictionary[word] = true;\n    });\n    var found = Object.create(null);\n    var combinations = 0;\n    function visit(word, used, indices) {\n        if (indices.length > 0) {\n            combinations += 1;\n            if (dictionary[word] && (!found[word] || indices.length > found[word].parts.length)) {\n                found[word] = {word: word, parts: indices.map(function (i) { return tiles[i]; }), indices: indices.slice()};\n            }\n        }\n        if (indices.length === 4) return;\n        for (var i = 0; i < 20; i += 1) {\n            if (!(used & (1 << i))) visit(word + tiles[i], used | (1 << i), indices.concat([i]));\n        }\n    }\n    visit('', 0, []);\n    var matches = Object.keys(found).map(function (word) { return found[word]; });\n    matches.sort(function (a, b) { return b.parts.length - a.parts.length || a.word.localeCompare(b.word); });\n    var lines = [\n        'Quartiles word candidates',\n        'Tiles: ' + tiles.join(' '),\n        'Dictionary: ' + dictionaryPath,\n        'Ordered tile combinations checked: ' + combinations,\n        'Unique dictionary matches: ' + matches.length,\n        '',\n        'These are dictionary candidates, not verified Apple News answers.',\n        'Check words in the puzzle yourself; no answer is entered and no Reveal command is used.',\n        'Each combination uses 1 to 4 distinct tile positions. A word may share tiles with other candidate words.',\n        ''\n    ];\n    matches.forEach(function (match) {\n        lines.push(match.parts.length + ' tiles | ' + match.word + ' | ' + match.parts.join(' + ') + ' | positions ' + match.indices.map(function (i) { return i + 1; }).join(', '));\n    });\n    if (!matches.length) lines.push('No matches in this dictionary. Check the tiles and dictionary selection.');\n    var outputPath = ObjC.unwrap($.NSTemporaryDirectory()) + 'rulr-quartiles-' + ObjC.unwrap($.NSUUID.UUID.UUIDString) + '.txt';\n    var writeError = Ref();\n    var ok = $(lines.join('\\n') + '\\n').writeToFileAtomicallyEncodingError(outputPath, true, $.NSUTF8StringEncoding, writeError);\n    if (!ok) throw new Error('Could not write the candidate report.');\n    return outputPath;\n}\n\nRULR_QUARTILES_JS\n"
                    }
                  }
                },
                "stopsFlowWhenUnsuccessful": {
                  "type": "boolean",
                  "value": true
                },
                "timeout": {
                  "type": "number",
                  "value": 120
                }
              }
