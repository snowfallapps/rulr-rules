                        },
                        "text": {
                          "type": "string",
                          "value": "-- Keep Finder's front window; close the remaining window snapshot.\ntell application \"Finder\"\n    if (count windows) < 2 then return\n    set otherWindows to every window whose index is greater than 1\n    repeat with otherWindow in otherWindows\n        close otherWindow\n    end repeat\nend tell\n"
