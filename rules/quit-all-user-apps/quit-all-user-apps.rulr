        "id": "EF0AB5D3-2B49-5D9E-92EE-E45FB806990E",
        "key": "trigger.input.hot-key-pressed"
      }
    ],
    "kind": "trigger",
    "title": "On Shortcut"
  },
  "startBehavior": "runAutomatically",
  "title": "Quit Open Apps"
}
