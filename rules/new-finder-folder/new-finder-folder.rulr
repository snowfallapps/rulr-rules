  "notificationBehavior": "staySilent",
  "ruleData": {
    "children": [
      {
        "children": [
          {
            "id": "38770CB9-CFE6-5E87-B7D8-354CBDC530FE",
            "instances": [
              {
                "configuration": {
                  "values": {
                    "inputs": {
                      "type": "array",
                      "value": []
                    },
                    "script": {
                      "type": "dictionary",
                      "value": {
                        "filePath": {
                          "type": "string",
                          "value": ""
                        },
                        "mode": {
                          "type": "string",
                          "value": "text-script"
                        },
                        "text": {
                          "type": "string",
                          "value": "tell application \"Finder\"\n    set chosenItems to selection as alias list\n    if (count chosenItems) is 0 then error \"Select files or folders in Finder first.\"\n    set sourceFolder to container of item 1 of chosenItems as alias\n    repeat with chosenItem in chosenItems\n        if (container of chosenItem as alias) is not sourceFolder then error \"Choose items from one folder.\"\n    end repeat\nend tell\nset response to display dialog \"Name the folder for the selected Finder items:\" default answer \"Collected Files\" buttons {\"Cancel\", \"Create and Move\"} default button \"Create and Move\" cancel button \"Cancel\"\nset folderName to text returned of response\nif folderName is \"\" or folderName contains \":\" or folderName contains \"/\" then error \"Use a nonempty folder name without a colon or slash.\"\ntell application \"Finder\"\n    if exists item folderName of sourceFolder then error \"That name already exists. Choose another name.\"\n    set groupedFolder to make new folder at sourceFolder with properties {name:folderName}\n    move chosenItems to groupedFolder\n    reveal groupedFolder\nend tell\n"
                        }
                      }
                    },
                    "stopsFlowWhenUnsuccessful": {
                      "type": "boolean",
                      "value": true
                    },
                    "timeout": {
                      "type": "number",
                      "value": 120
                    }
                  }
                },
                "id": "352B27CB-6B4E-5C85-BFB3-16A6BD3CA75A",
                "key": "action.run-apple-script"
              }
            ],
            "kind": "action",
            "title": "Group Selected Files"
          }
        ],
        "id": "89CD3E67-9721-5031-BF00-AC9A21270E86",
